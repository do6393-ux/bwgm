rules_version = '2';

// =====================================================================
//  부원 포털 Firestore 보안 규칙
//
//  권한 구조
//   - 관리자(isAdmin): do6393@ice.go.kr 한 명. 교사 추가/삭제, 정보 업무 열람·수정.
//   - 교사(isTeacher): 관리자 + teachers/{이메일} 문서가 있는 사람.
//                      (포털의 "teachers" 화면에서 관리자가 추가/삭제)
//   - 정보 업무 접근(hasWorkAccess): 관리자 + teachers 문서에 canWork: true 가 있는 교사.
//                      (포털의 "teachers" 화면에서 관리자가 교사별로 허용/해제. 열람·수정 모두 가능)
//   - 그 외(학생·외부인): 공지/수업자료/과제 읽기, 과제 제출(쓰기), 제출 확인 목록(학번·가린 이름) 읽기만 가능.
//
//  Firebase 콘솔 > Authentication 에서 이메일/비밀번호 "가입(sign-up)"은
//  켜 두어야 포털에서 교사 계정을 만들 수 있습니다. 외부인이 계정을 만들어도
//  teachers 허용 목록에 없으면 데이터에는 접근할 수 없습니다.
//
//  올린 뒤 점검
//   - 시크릿 창: "정보 수업" 탭만 보이고 공지/자료/과제가 읽히는지, 과제 화면에서 제출이 되는지,
//     제출 확인 목록에 학번·가린 이름만 보이고 내용은 보이지 않는지
//   - 관리자 로그인: 내 학급 / 정보 업무 / 교무실 / teachers 버튼
//   - 일반 교사 로그인: 첫 화면이 교무실(시간표), 정보 업무 탭은 흐리게 잠김, teachers 버튼 없음.
//     관리자가 teachers 화면에서 "정보 업무: 허용"을 켜면 탭이 열리고 열람·수정이 되는지 확인
//   - 학급 데이터가 비어 보이면 문서 ID 가 "<uid>_..."/레거시 형태가 아닌 것
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // 관리자 이메일을 바꾸면 src/lib/admin.js 의 ADMIN_EMAIL 도 같이 바꿀 것
    function isAdmin() {
      return signedIn() && myEmail() == 'do6393@ice.go.kr';
    }

    // 교사 = 관리자 또는 허용 목록(teachers 컬렉션, 문서 ID = 소문자 이메일)에 있는 사람
    function isTeacher() {
      return isAdmin()
        || (signedIn()
            && exists(/databases/$(database)/documents/teachers/$(myEmail())));
    }

    // 정보 업무 접근 권한 = 관리자 또는 teachers/{이메일}.canWork == true 인 교사
    function hasWorkAccess() {
      return isAdmin()
        || (isTeacher()
            && get(/databases/$(database)/documents/teachers/$(myEmail())).data.get('canWork', false) == true);
    }

    // 예전(바닐라 JS 시절 / 로그인 전 기본값) 키: "1_7", "1-7", "default_teacher_1_7"
    // 관리자 본인 데이터라 관리자에게만 허용 (다른 교사에게는 보이지 않음)
    function isLegacyKey(key) {
      return key.matches('[0-9]+[_-][0-9]+') || key.matches('default_teacher_.*');
    }

    // 학급 데이터: 본인 uid 로 시작하는 문서만. 관리자는 레거시 키 문서도 가능.
    function canAccessClassDoc(key) {
      return isTeacher()
        && (key.matches(request.auth.uid + '_.*')
            || (isAdmin() && isLegacyKey(key)));
    }

    // ---------- 교사 허용 목록: 관리자만 목록 조회·수정 ----------
    // 교사 본인은 자기 문서만 읽을 수 있다 (포털이 내 정보 업무 권한 canWork 를 확인하는 용도).
    // 쓰기는 관리자만 가능하므로 교사가 스스로 권한을 올릴 수 없다.
    match /teachers/{email} {
      allow get: if isAdmin() || (signedIn() && myEmail() == email);
      allow list, write: if isAdmin();
    }

    // ---------- 공개 읽기 / 교사만 쓰기 ----------
    match /notices/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /lessons/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---------- 과제 ----------
    // 과제는 누구나 읽고 교사만 쓴다. 학생 제출은 두 문서를 같은 ID 로 한 번에(batch) 쓴다.
    //   submissions/{sid}: 원본(학번·이름·내용). 학생은 쓰기만, 읽기는 교사만
    //   roster/{sid}:      공개 확인 목록(학번·가린 이름). 누구나 읽기
    // 한쪽만 생기지 않도록 서로 existsAfter/getAfter 로 확인한다.
    // 길이 제한은 src/lib/homework.js 의 NAME_MAX / TEXT_MAX 와 같게 둘 것.
    function homeworkOpen(hid) {
      return exists(/databases/$(database)/documents/homework/$(hid))
        && get(/databases/$(database)/documents/homework/$(hid)).data.get('open', false) == true;
    }

    function validStudentNum(v) {
      return v is string && v.matches('[1-9][0-9]{4}');
    }

    match /homework/{hid} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /homework/{hid}/submissions/{sid} {
      allow read, delete: if isTeacher();
      allow create: if request.resource.data.keys().hasOnly(['studentNum', 'studentName', 'text', 'createdAt'])
                    && request.resource.data.keys().hasAll(['studentNum', 'studentName', 'text', 'createdAt'])
                    && validStudentNum(request.resource.data.studentNum)
                    && request.resource.data.studentName is string
                    && request.resource.data.studentName.size() > 0
                    && request.resource.data.studentName.size() <= 20
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 5000
                    && request.resource.data.createdAt == request.time
                    && (homeworkOpen(hid) || isTeacher())
                    && getAfter(/databases/$(database)/documents/homework/$(hid)/roster/$(sid)).data.studentNum
                         == request.resource.data.studentNum;
      allow update: if false;
    }

    match /homework/{hid}/roster/{sid} {
      allow read: if true;
      allow delete: if isTeacher();
      allow create: if request.resource.data.keys().hasOnly(['studentNum', 'maskedName', 'createdAt'])
                    && request.resource.data.keys().hasAll(['studentNum', 'maskedName', 'createdAt'])
                    && validStudentNum(request.resource.data.studentNum)
                    && request.resource.data.maskedName is string
                    && request.resource.data.maskedName.size() > 0
                    && request.resource.data.maskedName.size() <= 20
                    && request.resource.data.maskedName.matches('.*[*].*')
                    && request.resource.data.createdAt == request.time
                    && existsAfter(/databases/$(database)/documents/homework/$(hid)/submissions/$(sid));
      allow update: if false;
    }

    // 과제 관리의 반 설정(반·인원). 교사만
    match /homework_settings/{id} {
      allow read, write: if isTeacher();
    }

    // ---------- 정보 업무 (보안점검·네트워크 매뉴얼 등) ----------
    // 열람·수정: 관리자 + 관리자가 허용한 교사(teachers/{이메일}.canWork == true)
    match /work_tasks/{id} {
      allow read, write: if hasWorkAccess();
    }

    // 정보 업무 카드의 첨부파일. Firebase Storage(유료 요금제 필요) 대신 Firestore 에 파일을 조각내어 둔다.
    // 조각 하나는 Bytes 800KB (문서 한계 1MiB). 권한은 위 work_tasks 와 같다.
    // 상위 규칙은 하위 컬렉션까지 적용되지 않으므로 따로 열어 줘야 한다.
    // 조각 크기 제한(900000)은 src/lib/attachments.js 의 CHUNK_BYTES(800KB)보다 크게 둔다.
    match /work_tasks/{id}/work_files/{chunkId} {
      allow read, delete: if hasWorkAccess();
      allow create, update: if hasWorkAccess()
                            && request.resource.data.keys().hasOnly(['attId', 'index', 'data'])
                            && request.resource.data.attId is string
                            && request.resource.data.index is int
                            && request.resource.data.data is bytes
                            && request.resource.data.data.size() <= 900000;
    }

    // 정보 업무 달력 일정. 카드에서 "달력에 넣기"를 하면 한 건씩 생긴다.
    // 날짜는 "YYYY-MM-DD" 문자열. 시작 ≤ 마감 점검은 포털 화면에서 하고, 여기서는 모양과 크기만 본다.
    // 제목·메모 길이는 src/lib/workCalendar.js 의 TITLE_MAX / NOTE_MAX 와 같게 둘 것.
    match /work_events/{id} {
      allow read, delete: if hasWorkAccess();
      allow create, update: if hasWorkAccess()
                            && request.resource.data.keys().hasOnly(['taskId', 'title', 'part', 'start', 'end', 'note', 'done', 'createdAt'])
                            && request.resource.data.keys().hasAll(['taskId', 'title', 'part', 'start', 'end', 'note', 'done', 'createdAt'])
                            && request.resource.data.taskId is string
                            && request.resource.data.taskId.size() <= 100
                            && request.resource.data.title is string
                            && request.resource.data.title.size() > 0
                            && request.resource.data.title.size() <= 120
                            && request.resource.data.part is string
                            && request.resource.data.part.size() <= 20
                            && request.resource.data.start is string
                            && request.resource.data.start.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                            && request.resource.data.end is string
                            && request.resource.data.end.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                            && request.resource.data.note is string
                            && request.resource.data.note.size() <= 1000
                            && request.resource.data.done is bool
                            && request.resource.data.createdAt is timestamp;
    }

    // 기자재 대여 장부 (정보 업무 › 기자재 대여). 권한은 정보 업무와 같다.
    //   equipment/inventory:  종류·번호 목록 한 문서 { kinds: [{ id, name, items: [{ id, label, repair }] }], updatedAt }
    //   equipment_loans/{id}: 빌려준 기록 한 건 (여러 대를 한 번에 빌려주면 한 건)
    //     반납 날짜(dueDate)는 2026-11-11에 없앴다. 그 전에 넣은 기록에 남아 있을 수 있어서 hasOnly 에만 둔다.
    // 개수·길이 제한은 src/lib/equipment.js 의 KINDS_MAX / LOAN_ITEMS_MAX / BORROWER_MAX / MEMO_MAX 와 같게 둘 것.
    match /equipment/{docId} {
      allow read, delete: if hasWorkAccess();
      allow create, update: if hasWorkAccess()
                            && docId == 'inventory'
                            && request.resource.data.keys().hasOnly(['kinds', 'updatedAt'])
                            && request.resource.data.kinds is list
                            && request.resource.data.kinds.size() <= 20;
    }

    match /equipment_loans/{id} {
      allow read, delete: if hasWorkAccess();
      allow create, update: if hasWorkAccess()
                            && request.resource.data.keys().hasOnly(['items', 'borrower', 'outDate', 'dueDate', 'memo', 'returned', 'open', 'createdAt', 'closedAt'])
                            && request.resource.data.keys().hasAll(['items', 'borrower', 'outDate', 'memo', 'returned', 'open', 'createdAt'])
                            && request.resource.data.items is list
                            && request.resource.data.items.size() > 0
                            && request.resource.data.items.size() <= 300
                            && request.resource.data.borrower is string
                            && request.resource.data.borrower.size() > 0
                            && request.resource.data.borrower.size() <= 40
                            && request.resource.data.outDate is string
                            && request.resource.data.outDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                            && request.resource.data.memo is string
                            && request.resource.data.memo.size() <= 200
                            && request.resource.data.returned is map
                            && request.resource.data.open is bool
                            && request.resource.data.createdAt is timestamp;
    }

    // 업무분장 목록 (정보 업무 › 보직 탭 › 업무분장 고치기). 2026-11-12
    //   work_config/duties: { parts: { head|plan|device|nais: [{ key, title, tool? }] }, updatedAt, updatedBy }
    //   문서가 없으면 화면은 src/lib/workDuties.js 의 DUTIES(업무분장(정보부).hwp)를 쓴다.
    // 읽기 = 정보 업무 접근 권한, 고치기 = 관리자 · 부장(teachers/{이메일}.workRole == 'head').
    // 보직마다 40개까지 (src/lib/workDuties.js 의 DUTIES_PER_PART_MAX 와 같게 둘 것).
    function isWorkHead() {
      return isAdmin()
        || (hasWorkAccess()
            && get(/databases/$(database)/documents/teachers/$(myEmail())).data.get('workRole', '') == 'head');
    }

    function dutyListOk(parts, part) {
      return parts.get(part, []) is list && parts.get(part, []).size() <= 40;
    }

    match /work_config/{docId} {
      allow read: if hasWorkAccess();
      allow create, update: if isWorkHead()
                            && docId == 'duties'
                            && request.resource.data.keys().hasOnly(['parts', 'updatedAt', 'updatedBy'])
                            && request.resource.data.parts is map
                            && request.resource.data.parts.keys().hasOnly(['head', 'plan', 'device', 'nais'])
                            && dutyListOk(request.resource.data.parts, 'head')
                            && dutyListOk(request.resource.data.parts, 'plan')
                            && dutyListOk(request.resource.data.parts, 'device')
                            && dutyListOk(request.resource.data.parts, 'nais');
      allow delete: if isAdmin();
    }

    // 바로가기 · 연락처 (정보 업무 › 바로가기·연락처). 2026-11-12. 권한은 정보 업무와 같다.
    //   work_links/{id}: 사이트 { kind: 'site', part, name, url, memo, pinned }
    //                    연락처 { kind: 'contact', part, name, role, phone, email, memo, pinned }  (+ createdAt, updatedAt)
    // 글자 수는 src/lib/workLinks.js 의 LINK_MAX 와 같게 둘 것. 주소는 http(s) 만 (javascript: 같은 링크 막기).
    function strOk(data, field, max) {
      return data.get(field, '') is string && data.get(field, '').size() <= max;
    }

    match /work_links/{id} {
      allow read, delete: if hasWorkAccess();
      allow create, update: if hasWorkAccess()
                            && request.resource.data.keys().hasOnly(['kind', 'part', 'name', 'url', 'role', 'phone', 'email', 'memo', 'pinned', 'createdAt', 'updatedAt'])
                            && request.resource.data.kind in ['site', 'contact']
                            && request.resource.data.part in ['common', 'head', 'plan', 'device', 'nais']
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 60
                            && strOk(request.resource.data, 'url', 500)
                            && (request.resource.data.get('url', '') == '' || request.resource.data.url.matches('https?://.+'))
                            && strOk(request.resource.data, 'role', 80)
                            && strOk(request.resource.data, 'phone', 40)
                            && strOk(request.resource.data, 'email', 100)
                            && strOk(request.resource.data, 'memo', 300)
                            && request.resource.data.get('pinned', false) is bool;
    }

    // ---------- 교사 공용 ----------
    match /base_timetables/{id} {
      allow read, write: if isTeacher();
    }

    match /shared_records_presets/{id} {
      allow read, write: if isTeacher();
    }

    // 컴시간 시간표 캐시. 매일 07:30(KST)에 GitHub Actions(sync-comcigan.js)가
    // firebase-admin(서비스 계정)으로 기록하므로 이 규칙과 무관하게 동작한다.
    // 포털 코드는 읽기만 하므로, 쓰기가 필요 없으면 `allow write: if false` 로 좁혀도 된다.
    match /timetable_schedules/{id} {
      allow read, write: if isTeacher();
    }

    // ---------- 학급 데이터 (학생 개인정보 포함) ----------
    match /homeroom_contacts/{key} {
      allow read, write: if canAccessClassDoc(key);
    }

    match /homeroom_seating/{key} {
      allow read, write: if canAccessClassDoc(key);
    }

    match /homeroom_cleaning/{key} {
      allow read, write: if canAccessClassDoc(key);
    }

    match /homeroom_records/{key} {
      allow read, write: if canAccessClassDoc(key);
    }

    // 그 외 모든 경로는 기본 거부
  }
}

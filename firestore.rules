rules_version = '2';

// =====================================================================
//  부원 포털 Firestore 보안 규칙
//
//  권한 구조
//   - 관리자(isAdmin): do6393@ice.go.kr 한 명. 교사 추가/삭제, 정보 업무 열람·수정.
//   - 교사(isTeacher): 관리자 + teachers/{이메일} 문서가 있는 사람.
//                      (포털의 "teachers" 화면에서 관리자가 추가/삭제)
//   - 정보 업무 접근(hasWorkAccess): 관리자 + teachers 문서에 canWork: true 가 있는 교사.
//                      (포털의 "teachers" 화면에서 관리자가 교사별로 허용/해제. 열람·수정 모두 가능)
//   - 그 외(학생·외부인): 공지/수업자료 읽기, 과제 제출(쓰기)만 가능.
//
//  Firebase 콘솔 > Authentication 에서 이메일/비밀번호 "가입(sign-up)"은
//  켜 두어야 포털에서 교사 계정을 만들 수 있습니다. 외부인이 계정을 만들어도
//  teachers 허용 목록에 없으면 데이터에는 접근할 수 없습니다.
//
//  올린 뒤 점검
//   - 시크릿 창: "정보 수업" 탭만 보이고 공지/자료가 읽히는지, 과제 제출이 되는지,
//     제출 목록(rx feed)이 보이지 않는지
//   - 관리자 로그인: 내 학급 / 정보 업무 / 교무실 / teachers 버튼
//   - 일반 교사 로그인: 첫 화면이 교무실(시간표), 정보 업무 탭은 흐리게 잠김, teachers 버튼 없음.
//     관리자가 teachers 화면에서 "정보 업무: 허용"을 켜면 탭이 열리고 열람·수정이 되는지 확인
//   - 학급 데이터가 비어 보이면 문서 ID 가 "<uid>_..."/레거시 형태가 아닌 것
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // 관리자 이메일을 바꾸면 src/lib/admin.js 의 ADMIN_EMAIL 도 같이 바꿀 것
    function isAdmin() {
      return signedIn() && myEmail() == 'do6393@ice.go.kr';
    }

    // 교사 = 관리자 또는 허용 목록(teachers 컬렉션, 문서 ID = 소문자 이메일)에 있는 사람
    function isTeacher() {
      return isAdmin()
        || (signedIn()
            && exists(/databases/$(database)/documents/teachers/$(myEmail())));
    }

    // 정보 업무 접근 권한 = 관리자 또는 teachers/{이메일}.canWork == true 인 교사
    function hasWorkAccess() {
      return isAdmin()
        || (isTeacher()
            && get(/databases/$(database)/documents/teachers/$(myEmail())).data.get('canWork', false) == true);
    }

    // 예전(바닐라 JS 시절 / 로그인 전 기본값) 키: "1_7", "1-7", "default_teacher_1_7"
    // 관리자 본인 데이터라 관리자에게만 허용 (다른 교사에게는 보이지 않음)
    function isLegacyKey(key) {
      return key.matches('[0-9]+[_-][0-9]+') || key.matches('default_teacher_.*');
    }

    // 학급 데이터: 본인 uid 로 시작하는 문서만. 관리자는 레거시 키 문서도 가능.
    function canAccessClassDoc(key) {
      return isTeacher()
        && (key.matches(request.auth.uid + '_.*')
            || (isAdmin() && isLegacyKey(key)));
    }

    // ---------- 교사 허용 목록: 관리자만 목록 조회·수정 ----------
    // 교사 본인은 자기 문서만 읽을 수 있다 (포털이 내 정보 업무 권한 canWork 를 확인하는 용도).
    // 쓰기는 관리자만 가능하므로 교사가 스스로 권한을 올릴 수 없다.
    match /teachers/{email} {
      allow get: if isAdmin() || (signedIn() && myEmail() == email);
      allow list, write: if isAdmin();
    }

    // ---------- 공개 읽기 / 교사만 쓰기 ----------
    match /notices/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /lessons/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ---------- 과제 제출: 학생은 쓰기(제출)만, 읽기는 교사만 ----------
    match /assignments/{id} {
      allow read: if isTeacher();

      allow create: if request.resource.data.keys().hasOnly(
                         ['studentNum', 'studentName', 'text', 'timeStr', 'createdAt'])
                    && request.resource.data.keys().hasAll(
                         ['studentNum', 'studentName', 'text', 'timeStr', 'createdAt'])
                    && request.resource.data.studentNum is string
                    && request.resource.data.studentNum.size() <= 10
                    && request.resource.data.studentName is string
                    && request.resource.data.studentName.size() <= 20
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 5000
                    && request.resource.data.timeStr is string
                    && request.resource.data.timeStr.size() <= 5
                    && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isTeacher();
    }

    // ---------- 정보 업무 (보안점검·네트워크 매뉴얼 등) ----------
    // 열람·수정: 관리자 + 관리자가 허용한 교사(teachers/{이메일}.canWork == true)
    match /work_tasks/{id} {
      allow read, write: if hasWorkAccess();
    }

    // ---------- 교사 공용 ----------
    match /base_timetables/{id} {
      allow read, write: if isTeacher();
    }

    match /shared_records_presets/{id} {
      allow read, write: if isTeacher();
    }

    // 컴시간 시간표 캐시. 매일 07:30(KST)에 GitHub Actions(sync-comcigan.js)가
    // firebase-admin(서비스 계정)으로 기록하므로 이 규칙과 무관하게 동작한다.
    // 포털 코드는 읽기만 하므로, 쓰기가 필요 없으면 `allow write: if false` 로 좁혀도 된다.
    match /timetable_schedules/{id} {
      allow read, write: if isTeacher();
    }

    // ---------- 학급 데이터 (학생 개인정보 포함) ----------
    match /homeroom_contacts/{key} {
      allow read, write: if canAccessClassDoc(key);
    }

    match /homeroom_seating/{key} {
      allow read, write: if canAccessClassDoc(key);
    }

    match /homeroom_cleaning/{key} {
      allow read, write: if canAccessClassDoc(key);
    }

    match /homeroom_records/{key} {
      allow read, write: if canAccessClassDoc(key);
    }

    // 그 외 모든 경로는 기본 거부
  }
}
